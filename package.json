{
  "name": "pathlight",
  "private": true,
  "version": "1.0.0",
  "description": "PathLight: a private, in-browser pathology report decoder for cancer patients.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/copy-ocr.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "eval": "vite-node scripts/eval.ts",
    "eval:tcga": "vite-node scripts/eval-tcga.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdfjs-dist": "4.4.168",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "20.16.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.2",
    "typescript": "5.6.3",
    "vite": "5.4.9",
    "vite-node": "2.1.3",
    "vitest": "2.1.3"
  }
